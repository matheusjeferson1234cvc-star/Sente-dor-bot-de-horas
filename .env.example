# Nunca publique seu token nem envie este arquivo preenchido para outras pessoas.
DISCORD_TOKEN=COLE_SEU_TOKEN_APENAS_NA_HOSPEDAGEM
# Opcional: seu ID da aplicação; se não preencher, o bot usa o próprio ID.
CLIENT_ID=
# Opcional: ID do servidor de testes para os comandos aparecerem imediatamente.
GUILD_ID=
# Opcional: URL HTTPS de imagem (ícone/logo da corporação).
# Se vazio, o bot mostra o ícone do servidor ou avatar do bot.
CETUS_LOGO_URL=
